# ═══════════════════════════════════════════════════════════════════════════════
# Conecta Barra 2.0 — modelo de variáveis. Copie para `.env` (NUNCA envie o .env ao GitHub).
# Este arquivo serve para rodar o servidor no SEU computador/Docker. No Render, cadastre as mesmas
# variáveis em Environment (guia, passo 5). O app (APK) usa só o que está em eas.json → env.
# ═══════════════════════════════════════════════════════════════════════════════

# --- Banco (TiDB Cloud, guia passo 3) ---
DATABASE_URL=mysql://USUARIO:SENHA@gateway01.REGIAO.prod.aws.tidbcloud.com:4000/test
DATABASE_SSL=true

# --- Segredos (gere cada um com: openssl rand -hex 32) ---
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# --- Login da gestão (você escolhe) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- URL pública do servidor (no Render é automática) ---
PUBLIC_URL=

# --- E-mail (Brevo, guia passo 6) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
# true = exige código por e-mail no cadastro (só vale se a Brevo estiver configurada)
REQUIRE_EMAIL_VERIFICATION=true
# true = novos cadastros ficam "pendentes" até a gestão aprovar
REQUIRE_RESIDENT_APPROVAL=false

# --- Push (Firebase, guia passo 7): cole o JSON inteiro da conta de serviço (ou em base64) ---
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Login com Google (opcional, guia passo 8) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# --- Só para compilar o app localmente (`npm run build:apk:local`) ---
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
