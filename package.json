{
  "name": "conecta-barra",
  "version": "2.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:app\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:app": "expo start",
    "assets": "node scripts/generate-brand-assets.mjs",
    "postinstall": "node scripts/generate-brand-assets.mjs",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --out-extension:.js=.mjs",
    "start:server": "NODE_ENV=production node dist/index.mjs",
    "db:push": "drizzle-kit push",
    "db:check": "node scripts/db-check.mjs",
    "db:encrypt": "tsx scripts/encrypt-existing-data.ts",
    "check": "tsc --noEmit",
    "android": "expo run:android",
    "build:apk": "node scripts/setup-check.mjs --strict --profile preview && cross-env CONECTA_STRICT=1 npx --yes eas-cli build --platform android --profile preview",
    "build:aab": "node scripts/setup-check.mjs --strict --profile production && cross-env CONECTA_STRICT=1 npx --yes eas-cli build --platform android --profile production",
    "build:apk:local": "node scripts/setup-check.mjs --strict && npm run assets && cross-env CONECTA_STRICT=1 expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "update:ota": "npx --yes eas-cli update --channel production --message",
    "ios": "expo run:ios",
    "setup:check": "node scripts/setup-check.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.7.2",
    "babel-preset-expo": "~54.0.10",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "expo": "~54.0.29",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.12",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "^15.0.0",
    "expo-linking": "~8.0.10",
    "expo-local-authentication": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "^29.0.0",
    "expo-web-browser": "~15.0.10",
    "express": "^4.22.1",
    "jose": "6.1.0",
    "mysql2": "^3.16.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/react": "~19.1.17",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
